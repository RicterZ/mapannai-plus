# 复制为 .env 并填写实际值。地图和地点服务分别选择，可自由组合。
# 修改服务端变量后重启/重新部署；NEXT_PUBLIC_* 变量需在构建前设置。

# ── 地图渲染 ─────────────────────────────────────────────
# osm：MapLibre + OpenStreetMap（默认）
# amap：高德地图官方 JS API 2.0
MAP_RENDERER=osm

# 仅 MAP_RENDERER=amap 时必填：高德控制台申请「Web端(JS API)」Key。
# 安全密钥与这个 JS Key 配套，不是下面的 Web 服务 Key。
# 在高德控制台配置部署域名白名单，例如 map.home.ricterz.me。
# 当前实现将 JS Key 和安全密钥下发浏览器，用于 _AMapSecurityConfig。
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# 仅 osm 使用：true（默认）走同源 /osm-tiles/{z}/{x}/{y}.png，
# 需 nginx/CDN 配置代理 https://tile.openstreetmap.org/。
# false：浏览器直接访问 OSM 官方瓦片，无需反代。
NEXT_PUBLIC_OSM_TILE_PROXY=true

# ── 地点服务（与地图渲染引擎独立）─────────────────────────
# 三项各自支持 google | amap，默认 google；网页与 MCP 共用这些默认值。
# 高德地点服务适合中国；海外地点请选择 google。
MAP_SEARCH_PROVIDER=google
MAP_DETAILS_PROVIDER=google
MAP_DIRECTIONS_PROVIDER=google

# 任一服务选 google 时需要 Google API Key。
# 在 Google 控制台启用 Places API、Geocoding API、Directions API（按所用能力）。
# BASE_URL 可改为你的 Google API 反向代理地址；通常保留默认值。
GOOGLE_API_KEY=
GOOGLE_API_BASE_URL=https://maps.googleapis.com

# 任一服务选 amap 时需要高德控制台申请的「Web服务」Key。
# 不要填 AMAP_JS_KEY：JS 地图和后端 Web 服务使用两种不同类型的 Key。
AMAP_API_KEY=
AMAP_API_BASE_URL=https://restapi.amap.com

# 全部使用高德的示例：修改以上四个选择值并填三个高德凭据即可。
# MAP_RENDERER=amap
# MAP_SEARCH_PROVIDER=amap
# MAP_DETAILS_PROVIDER=amap
# MAP_DIRECTIONS_PROVIDER=amap
# AMAP_JS_KEY=你的Web端JS_API_Key
# AMAP_JS_SECURITY_CODE=对应安全密钥
# AMAP_API_KEY=你的Web服务Key
# 旧 NEXT_PUBLIC_MAP_BASEMAP / NEXT_PUBLIC_MAP_*_PROVIDER 已不再使用。

# ── 数据存储与访问认证 ───────────────────────────────────
# SQLite 默认 ./data/mapannai.db；容器部署可改为挂载的数据目录。
# SQLITE_PATH=/data/mapannai.db

# 留空不启用 API 认证；配置后前端弹窗输入同一个 token。
# MCP 使用 Authorization: Bearer <token>，或 x-api-token: <token>。
API_TOKEN=

# ── 腾讯云 COS（可选，用于图片上传）───────────────────────
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-chongqing
TENCENT_COS_BUCKET=
# 构建时设置，多个图片域名用英文逗号分隔，仅填域名不含协议。
# NEXT_PUBLIC_IMAGE_DOMAINS=your-bucket.cos.ap-chongqing.myqcloud.com

# 移动端面板动效、软键盘适配和触摸反馈不需要额外环境变量。
# 减少动态效果遵循浏览器 / 操作系统 prefers-reduced-motion 设置。

# 路径、OVER_DIRECTION_RANGE 和不支持地区结果持久保存在 SQLITE_PATH；部署需保留数据库挂载，无需新配置。

# 不可规划路段回退虚线贝塞尔关联曲线，仅改变显示，不重复请求寻路。
